WAREHOUSE_PORT=8088
WAREHOUSE_ADMIN_USER=admin
WAREHOUSE_ADMIN_PASSWORD=change-this-strong-password
WAREHOUSE_DATA_ENCRYPTION=1
WAREHOUSE_DATA_KEY=change-this-32-byte-data-encryption-key
# Optional: comma-separated hostnames/IPs accepted by the app Host header check.
WAREHOUSE_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: when set, assistant/image/LCSC outbound HTTP calls are limited to these domains.
WAREHOUSE_ALLOWED_API_HOSTS=api.openai.com,api.deepseek.com,openrouter.ai,www.szlcsc.com,easyeda.com,modules.easyeda.com
